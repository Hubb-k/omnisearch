{
  "manifest_version": 3,
  "name": "OmniSearch — Net Intelligence",
  "version": "0.1.0",
  "description": "Локальный когнитивный кэш. Данные не покидают устройство.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OmniSearch"
  }
}